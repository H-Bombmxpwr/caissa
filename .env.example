# Copy to .env and fill in. .env is gitignored and never shipped in a build.
#
# Optional. Enables the AI background note on the analysis board's Facts tab,
# alongside the sourced Wikipedia results. Without it the tab still works and
# simply shows no AI note. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to a current flash model.
GEMINI_MODEL=
